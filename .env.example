# Ledger Environment Configuration Template
# Copy to .env for local overrides. Never commit real credentials.

# Backend
SERVER_PORT=8082
SPRING_PROFILES_ACTIVE=h2

# Database (PostgreSQL profile)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=change_me_local_only

# Security & Sessions
LEDGER_SESSION_COOKIE_SECURE=false
LEDGER_SESSION_TTL_HOURS=24
LEDGER_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# File Storage
LEDGER_STORAGE_DIR=./backend/uploads

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3002
BACKEND_URL=http://127.0.0.1:8082
PORT=3002
